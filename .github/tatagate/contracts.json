    {
      "function": "scripts/build.test",
      "path": "scripts/build.test.mjs",
      "runner": "node",
      "target": "node"
    },
    {
      "function": "scripts/ci/android/life-android/test",
      "path": "scripts/ci/android/life-android/test.mjs",
      "runner": "node",
      "target": "node"
    },
    {
      "function": "scripts/ci/ios/life-ios/test",
      "path": "scripts/ci/ios/life-ios/test.mjs",
      "runner": "node",
      "target": "node"
    },
    {
      "function": "scripts/flow.test",
      "path": "scripts/flow.test.mjs",
      "runner": "node",
      "target": "node"
    },
    {
      "function": "scripts/project.test",
      "path": "scripts/project.test.mjs",
      "runner": "node",
      "target": "node"
    },
    {
      "function": "scripts/release/android/life-android/test",
      "path": "scripts/release/android/life-android/test.mjs",
      "runner": "node",
      "target": "node"
    },
    {
      "function": "scripts/release/ios/life-ios/test",
      "path": "scripts/release/ios/life-ios/test.mjs",
      "runner": "node",
      "target": "node"
    },
    {
      "function": "scripts/resources.test",
      "path": "scripts/resources.test.mjs",
      "runner": "node",
      "target": "node"
    },
    {
      "function": "test/app_test",
      "path": "test/app_test.dart",
      "runner": "flutter",
      "target": "flutter"
    },
    {
      "function": "test/product_contract_test",
      "path": "test/product_contract_test.dart",
      "runner": "flutter",
      "target": "flutter"
    }
  ]
